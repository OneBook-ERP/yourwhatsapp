{
    "name": "WhatsApp Message",
    "module": "Yourwhatsapp",
    "doctype": "DocType",
    "engine": "InnoDB",
    "autoname": "hash",
    "naming_rule": "Random",
    "sort_field": "creation",
    "sort_order": "DESC",
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "type",
            "fieldtype": "Select",
            "label": "Type",
            "options": "Outgoing\nIncoming",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Data",
            "label": "Status",
            "read_only": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "whatsapp_account",
            "fieldtype": "Link",
            "label": "WhatsApp Account",
            "options": "WhatsApp Account",
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "column_break_top",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "to",
            "fieldtype": "Data",
            "label": "To",
            "depends_on": "eval:doc.type=='Outgoing'",
            "in_list_view": 1
        },
        {
            "fieldname": "from",
            "fieldtype": "Data",
            "label": "From",
            "depends_on": "eval:doc.type=='Incoming'"
        },
        {
            "fieldname": "section_break_content",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "use_template",
            "fieldtype": "Check",
            "label": "Use Template",
            "default": "0"
        },
        {
            "fieldname": "template",
            "fieldtype": "Link",
            "label": "Template",
            "options": "WhatsApp Templates",
            "depends_on": "eval:doc.use_template==1"
        },
        {
            "fieldname": "template_parameters",
            "fieldtype": "Small Text",
            "label": "Template Parameters",
            "read_only": 1
        },
        {
            "fieldname": "template_header_parameters",
            "fieldtype": "Small Text",
            "label": "Template Header Parameters",
            "read_only": 1
        },
        {
            "fieldname": "column_break_content",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "message",
            "fieldtype": "HTML Editor",
            "label": "Message"
        },
        {
            "fieldname": "message_type",
            "fieldtype": "Select",
            "label": "Message Type",
            "options": "Manual\nTemplate",
            "default": "Manual",
            "read_only": 1
        },
        {
            "fieldname": "content_type",
            "fieldtype": "Select",
            "label": "Content Type",
            "options": "text\ndocument\nimage\nvideo\naudio\nreaction",
            "default": "text",
            "reqd": 1
        },
        {
            "fieldname": "attach",
            "fieldtype": "Attach",
            "label": "Attach",
            "depends_on": "eval:['document','image','video','audio'].includes(doc.content_type)"
        },
        {
            "fieldname": "section_break_reply",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "message_id",
            "fieldtype": "Data",
            "label": "Message ID",
            "read_only": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "is_reply",
            "fieldtype": "Check",
            "label": "Is Reply",
            "default": "0"
        },
        {
            "fieldname": "reply_to_message_id",
            "fieldtype": "Data",
            "label": "Reply To Message ID"
        },
        {
            "fieldname": "column_break_reply",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "error_reason",
            "fieldtype": "Small Text",
            "label": "Error Reason",
            "read_only": 1,
            "depends_on": "eval:doc.status=='Failed'"
        },
        {
            "fieldname": "is_lid_sender",
            "fieldtype": "Check",
            "label": "Unresolved Sender (LID)",
            "description": "The sender's phone number could not be resolved; the number shown is a WhatsApp LID.",
            "read_only": 1,
            "default": "0"
        },
        {
            "fieldname": "attempted_accounts",
            "fieldtype": "Small Text",
            "label": "Attempted Accounts",
            "hidden": 1,
            "read_only": 1
        },
        {
            "fieldname": "section_break_reference",
            "fieldtype": "Section Break"
        },
        {
            "fieldname": "reference_doctype",
            "fieldtype": "Link",
            "label": "Reference DocType",
            "options": "DocType"
        },
        {
            "fieldname": "column_break_reference",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "reference_name",
            "fieldtype": "Dynamic Link",
            "label": "Reference Name",
            "options": "reference_doctype"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "WhatsApp Admin",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "WhatsApp Operator",
            "read": 1,
            "write": 1,
            "create": 1
        },
        {
            "role": "Sales Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "Sales User",
            "read": 1,
            "write": 1,
            "create": 1
        }
    ]
}
