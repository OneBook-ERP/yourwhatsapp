{
    "name": "WhatsApp Templates",
    "module": "Yourwhatsapp",
    "doctype": "DocType",
    "engine": "InnoDB",
    "autoname": "field:template_name",
    "naming_rule": "By fieldname",
    "sort_field": "modified",
    "sort_order": "DESC",
    "fields": [
        {
            "fieldname": "template_name",
            "fieldtype": "Data",
            "label": "Template Name",
            "reqd": 1,
            "unique": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "APPROVED\nPENDING\nREJECTED",
            "default": "APPROVED",
            "in_list_view": 1,
            "description": "CRM's template picker only offers APPROVED templates"
        },
        {
            "fieldname": "for_doctype",
            "fieldtype": "Link",
            "label": "For DocType",
            "options": "DocType",
            "description": "Offer this template only on this DocType in CRM; empty means everywhere"
        },
        {
            "fieldname": "header",
            "fieldtype": "Data",
            "label": "Header"
        },
        {
            "fieldname": "template",
            "fieldtype": "Text",
            "label": "Template",
            "reqd": 1,
            "description": "Use {{1}}, {{2}}, ... as placeholders"
        },
        {
            "fieldname": "parameters",
            "fieldtype": "Table",
            "label": "Parameters",
            "options": "WhatsApp Template Parameter",
            "description": "Where each {{n}} gets its value from the message's reference document"
        },
        {
            "fieldname": "footer",
            "fieldtype": "Data",
            "label": "Footer"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "WhatsApp Admin",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "WhatsApp Operator",
            "read": 1
        },
        {
            "role": "Sales Manager",
            "read": 1,
            "write": 1,
            "create": 1
        },
        {
            "role": "Sales User",
            "read": 1
        }
    ]
}
