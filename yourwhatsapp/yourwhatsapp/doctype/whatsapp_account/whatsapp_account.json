{
    "name": "WhatsApp Account",
    "module": "Yourwhatsapp",
    "doctype": "DocType",
    "engine": "InnoDB",
    "autoname": "field:account_name",
    "naming_rule": "By fieldname",
    "sort_field": "modified",
    "sort_order": "DESC",
    "track_changes": 1,
    "fields": [
        {
            "fieldname": "account_name",
            "fieldtype": "Data",
            "label": "Account Name",
            "reqd": 1,
            "unique": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "phone_number",
            "fieldtype": "Data",
            "label": "Phone Number",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Active\nPaused\nDisconnected\nRateLimited",
            "default": "Disconnected",
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "column_break_status",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "is_default_incoming",
            "fieldtype": "Check",
            "label": "Is Default Incoming"
        },
        {
            "fieldname": "is_default_outgoing",
            "fieldtype": "Check",
            "label": "Is Default Outgoing"
        },
        {
            "fieldname": "section_break_routing",
            "fieldtype": "Section Break",
            "label": "Routing"
        },
        {
            "fieldname": "priority",
            "fieldtype": "Int",
            "label": "Priority",
            "description": "Lower number = higher priority",
            "default": "1"
        },
        {
            "fieldname": "last_used",
            "fieldtype": "Datetime",
            "label": "Last Used",
            "read_only": 1
        },
        {
            "fieldname": "column_break_limits",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "daily_limit",
            "fieldtype": "Int",
            "label": "Daily Limit",
            "default": "200"
        },
        {
            "fieldname": "daily_message_count",
            "fieldtype": "Int",
            "label": "Daily Message Count",
            "read_only": 1,
            "default": "0"
        },
        {
            "fieldname": "section_break_session",
            "fieldtype": "Section Break",
            "label": "Relay Session"
        },
        {
            "fieldname": "session_id",
            "fieldtype": "Data",
            "label": "Session ID",
            "read_only": 1,
            "unique": 1
        },
        {
            "fieldname": "qr_code",
            "fieldtype": "Attach Image",
            "label": "QR Code",
            "read_only": 1
        },
        {
            "fieldname": "column_break_health",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "connected_at",
            "fieldtype": "Datetime",
            "label": "Connected At",
            "read_only": 1
        },
        {
            "fieldname": "last_health_check",
            "fieldtype": "Datetime",
            "label": "Last Health Check",
            "read_only": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "WhatsApp Admin",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "WhatsApp Operator",
            "read": 1
        }
    ]
}
