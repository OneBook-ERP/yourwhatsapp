{
    "name": "WhatsApp Settings",
    "module": "Yourwhatsapp",
    "doctype": "DocType",
    "engine": "InnoDB",
    "issingle": 1,
    "fields": [
        {
            "fieldname": "default_incoming_account",
            "fieldtype": "Link",
            "label": "Default Incoming Account",
            "options": "WhatsApp Account"
        },
        {
            "fieldname": "default_outgoing_account",
            "fieldtype": "Link",
            "label": "Default Outgoing Account",
            "options": "WhatsApp Account"
        },
        {
            "fieldname": "column_break_defaults",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "routing_strategy",
            "fieldtype": "Select",
            "label": "Routing Strategy",
            "options": "Round Robin\nPriority",
            "default": "Round Robin"
        },
        {
            "fieldname": "section_break_relay",
            "fieldtype": "Section Break",
            "label": "Relay Connection"
        },
        {
            "fieldname": "relay_base_url",
            "fieldtype": "Data",
            "label": "Relay Base URL",
            "description": "e.g. http://localhost:8800"
        },
        {
            "fieldname": "relay_reachable_frappe_url",
            "fieldtype": "Data",
            "label": "Callback URL (Frappe as reachable from the relay)",
            "description": "Where the relay sends incoming messages and status updates. Leave empty to use this site's URL. In Docker, use the internal URL, e.g. http://frontend:8080; on a dev bench, http://127.0.0.1:<port> (.localhost names may not resolve from the relay)."
        },
        {
            "fieldname": "column_break_relay",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "relay_api_key",
            "fieldtype": "Password",
            "label": "Relay API Key",
            "description": "Set by Connect Relay / Rotate Key. Typed by hand only for a relay whose key comes from its RELAY_API_KEY environment variable."
        },
        {
            "fieldname": "relay_bootstrap_token",
            "fieldtype": "Password",
            "label": "Relay Bootstrap Token",
            "description": "Only if the relay sets RELAY_BOOTSTRAP_TOKEN: sent with Connect Relay."
        },
        {
            "fieldname": "relay_pending_key",
            "fieldtype": "Password",
            "label": "Relay Pending Key",
            "hidden": 1,
            "read_only": 1,
            "description": "A new key sent to the relay whose answer was not confirmed yet; Retry finishes the change."
        },
        {
            "fieldname": "section_break_relay_status",
            "fieldtype": "Section Break",
            "label": "Relay Status"
        },
        {
            "fieldname": "relay_status_html",
            "fieldtype": "HTML",
            "label": "Relay Status"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1
        },
        {
            "role": "WhatsApp Admin",
            "read": 1,
            "write": 1
        },
        {
            "role": "Sales Manager",
            "read": 1
        }
    ]
}
